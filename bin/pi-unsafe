#!/bin/bash
set -euo pipefail

# Load the host-global Pi secrets file before constructing defaults or starting
# Node. This is the same ~/.pi/.env used by the VM template, but pi-unsafe
# runs directly on the host and therefore cannot rely on the guest entrypoint.
pi_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
if [[ -f "$pi_root/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$pi_root/.env"
  set +a
fi

# Keep RTK telemetry disabled when Pi runs directly on the host as well.
export RTK_TELEMETRY_DISABLED=1

export FACELIFT_THEME=gruvbox-dark-hard
export FACELIFT_MAX_PREVIEW_LINES=10
export LLAMA_BASE_URL="${LLAMA_BASE_URL:-http://127.0.0.1:8080}"
export PI_OFFLINE=1

# pi-update declares Pi in this repository's shared mise.toml. Resolve it from
# the Pi config root so a project's tool configuration cannot select a different
# Pi installation, while preserving the directory from which this launcher was
# invoked for Pi.
launch_dir="$(pwd -P)"
host_pi="$(mise which -C "$pi_root" pi 2>/dev/null || true)"
if [[ -z "$host_pi" || ! -x "$host_pi" ]]; then
  echo "Could not find the host Pi CLI installed through mise." >&2
  echo "Run $pi_root/bin/pi-update to install or repair it." >&2
  exit 1
fi

# A bare launcher invocation resumes the most recent host session. Supplying an
# argument preserves Pi's normal CLI behavior (use -c explicitly when
# continuing alongside an initial prompt).
if (( $# == 0 )); then
  set -- -c
fi

# pi-web-search also registers Gemini-only url_context; expose only web_search.
exec mise exec -q -C "$pi_root" -- bash -c '
  cd -- "$1"
  shift
  host_pi="$1"
  shift
  # Package commands use their own parser and cannot accept agent tool options.
  # They do not start an agent, so url_context does not need to be excluded.
  case "${1-}" in
    install|remove|uninstall|update|list|config|auth)
      exec "$host_pi" "$@"
      ;;
    *)
      exec "$host_pi" --exclude-tools url_context "$@"
      ;;
  esac
' bash "$launch_dir" "$host_pi" "$@"
