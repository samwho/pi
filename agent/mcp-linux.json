{
  "mcpServers": {
    "chrome-devtools": {
      "command": "/home/pi/.local/bin/mise",
      "args": [
        "exec",
        "-q",
        "node@latest",
        "--",
        "chrome-devtools-mcp",
        "--headless",
        "--isolated",
        "--executablePath=/usr/bin/chromium",
        "--chrome-arg=--no-sandbox",
        "--chrome-arg=--disable-dev-shm-usage",
        "--allowUnrestrictedPaths"
      ]

    }
  }
}
