#!/bin/bash
set -euo pipefail

template="${PI_VM_TEMPLATE:-pi-template}"
if ! orb info "$template" >/dev/null 2>&1; then
  echo "$template is missing. Run $HOME/.pi/agent/bin/pi-update." >&2
  exit 1
fi

project_dir="$(pwd -P)"
project_key="$(printf '%s' "$project_dir" | shasum -a 256 | cut -c1-12)"
profile="${PI_VM_PROFILE:-default}"
if [[ ! "$profile" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "PI_VM_PROFILE may contain only letters, digits, dot, underscore, and dash." >&2
  exit 2
fi

pi_dir="${PI_CONFIG_DIR:-$HOME/.pi}"
host_config="$pi_dir/agent"
if [[ ! -d "$host_config" ]]; then
  echo "Pi configuration directory is missing: $host_config" >&2
  exit 1
fi

state_root="${PI_VM_STATE_ROOT:-$HOME/.local/share/pi-vm}"
runtime_root="$state_root/runtime"
profile_key="$(printf '%s' "$profile" | shasum -a 256 | cut -c1-8)"
machine="pi-${project_key}-${profile_key}"
launch_dir="$runtime_root/launch-$machine"
mkdir -p "$runtime_root" "$launch_dir"
chmod 0700 "$state_root" "$runtime_root" "$launch_dir" 2>/dev/null || true

# The runtime launch directory is mounted so the guest can verify that this
# invocation has supplied its required runtime mounts. Record the host's
# non-loopback IPv4 addresses on the host's default local subnet so the guest
# can reach services on this Mac while remaining unable to reach other devices
# on that network. Matching the netmask and broadcast keeps unrelated host
# interfaces, such as OrbStack bridges and VPNs, out of this exception.
default_interface="$(route -n get default 2>/dev/null | awk '/interface:/ { print $2; exit }')"
local_network=""
if [[ -n "$default_interface" ]]; then
  local_network="$(ifconfig "$default_interface" 2>/dev/null | awk '$1 == "inet" { print $4 " " $6; exit }')"
fi
local_netmask="${local_network%% *}"
local_broadcast="${local_network#* }"
host_ips=""
if [[ -n "$local_netmask" && "$local_network" != "$local_netmask" && -n "$local_broadcast" ]]; then
  host_ips="$(ifconfig | awk -v netmask="$local_netmask" -v broadcast="$local_broadcast" '
    $1 == "inet" && $4 == netmask && $6 == broadcast && $2 !~ /^127\./ && $2 !~ /^169\.254\./ { print $2 }
  ' | sort -u)"
fi
if [[ -z "$host_ips" ]]; then
  echo "Could not determine any non-loopback host IPv4 addresses." >&2
  rm -rf "$launch_dir"
  exit 1
fi
printf '%s\n' "$host_ips" >"$launch_dir/host-ips"

cleanup() {
  orb stop "$machine" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if orb info "$machine" >/dev/null 2>&1; then
  if orbctl list --running --quiet | grep -Fxq "$machine"; then
    echo "$machine is already running for this directory and profile." >&2
    exit 1
  fi
else
  # The VM is persistent per project/profile. Its sessions, dependency tree,
  # package store, and other mutable state live on its disk, not on the host.
  orb clone "$template" "$machine" >/dev/null
fi

for path in "$project_dir" "$host_config" "$launch_dir"; do
  if [[ "$path" == *','* ]]; then
    echo "OrbStack mount paths containing commas are not supported: $path" >&2
    exit 2
  fi
done
orb config set "machine.$machine.mounts" \
  "$project_dir:/workspace,$host_config:/mnt/pi-host,$launch_dir:/mnt/pi-launch"
orb start "$machine" >/dev/null

sandbox_term="${TERM:-xterm-256color}"
[[ "$sandbox_term" == *ghostty* ]] && sandbox_term=xterm-256color

# A bare launcher invocation resumes the most recent session for this project.
# Supplying any argument preserves Pi's normal CLI behavior (use -c explicitly
# when continuing alongside an initial prompt).
guest_args=("$@")
if (( ${#guest_args[@]} == 0 )); then
  guest_args=(-c)
fi

orb -m "$machine" -u pi \
  env "TERM=$sandbox_term" \
      "COLORTERM=${COLORTERM:-}" \
      "TERM_PROGRAM=${TERM_PROGRAM:-}" \
      PI_SKIP_VERSION_CHECK=1 \
  bash -c 'cd /workspace && exec /usr/local/bin/pi-guest "$@"' pi "${guest_args[@]}"
