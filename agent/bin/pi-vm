#!/bin/bash
set -euo pipefail

template="${PI_VM_TEMPLATE:-pi-template}"
if ! orb info "$template" >/dev/null 2>&1; then
  echo "$template is missing. Run $HOME/.pi/agent/bin/pi-rebuild." >&2
  exit 1
fi

project_dir="$(pwd -P)"
project_key="$(printf '%s' "$project_dir" | shasum -a 256 | cut -c1-12)"
profile="${PI_VM_PROFILE:-default}"
if [[ ! "$profile" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "PI_VM_PROFILE may contain only letters, digits, dot, underscore, and dash." >&2
  exit 2
fi
machine="pi-${project_key}-$$-$(printf '%04x' "$((RANDOM & 65535))")"
state_root="${PI_VM_STATE_ROOT:-$HOME/.local/share/pi-vm}"
sessions_dir="$state_root/sessions/$profile/$project_key"
mkdir -p "$sessions_dir"
chmod 0700 "$state_root" "$state_root/sessions" "$state_root/sessions/$profile" "$sessions_dir" 2>/dev/null || true

cleanup() {
  orb delete -f "$machine" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Clones are copy-on-demand and start stopped. Only the workspace and this
# profile/project's session directory are shared from macOS.
orb clone "$template" "$machine" >/dev/null
if [[ "$project_dir" == *','* || "$sessions_dir" == *','* ]]; then
  echo "OrbStack mount paths containing commas are not supported." >&2
  exit 2
fi
orb config set "machine.$machine.mounts" \
  "$project_dir:/workspace,$sessions_dir:/home/pi/.pi/agent/sessions"
orb start "$machine" >/dev/null

# Select one deliberate macOS address. Isolated machines cannot use
# host.orb.internal, but without --isolate-network they may reach host IPs.
host_ip="${PI_VM_HOST_IP:-}"
if [[ -z "$host_ip" ]]; then
  interface="$(route -n get default 2>/dev/null | awk '/interface:/ { print $2; exit }')"
  [[ -n "$interface" ]] && host_ip="$(ipconfig getifaddr "$interface" 2>/dev/null || true)"
fi
if [[ ! "$host_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  echo "Could not determine the host IPv4 address; set PI_VM_HOST_IP explicitly." >&2
  exit 1
fi

# Reload the root-owned egress policy with the exact host exception, and cover
# Git metadata with a read-only bind mount after OrbStack mounts the workspace.
orb -m "$machine" -u root bash -s -- "$host_ip" <<'GUEST_ROOT'
set -euo pipefail
printf '%s\n' "$1" >/etc/pi-sandbox/host-ip
/usr/local/bin/pi-network-lockdown
if [[ -e /workspace/.git ]]; then
  mount --bind /workspace/.git /workspace/.git
  mount -o remount,bind,ro /workspace/.git
fi
GUEST_ROOT

sandbox_term="${TERM:-xterm-256color}"
[[ "$sandbox_term" == *ghostty* ]] && sandbox_term=xterm-256color

orb -m "$machine" -u pi \
  env "TERM=$sandbox_term" \
      "COLORTERM=${COLORTERM:-}" \
      "TERM_PROGRAM=${TERM_PROGRAM:-}" \
      PI_SKIP_VERSION_CHECK=1 \
  bash -c 'cd /workspace && exec /usr/local/bin/pi-guest "$@"' pi "$@"
