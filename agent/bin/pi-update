#!/bin/bash
set -euo pipefail

template="${PI_VM_TEMPLATE:-pi-template}"
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cpus="${PI_VM_CPUS:-4}"
memory="${PI_VM_MEMORY:-4G}"
disk="${PI_VM_DISK:-64G}"

memory_mib() {
  case "$1" in
    *[Gg]) echo "$(( ${1%[Gg]} * 1024 ))" ;;
    *[Mm]) echo "${1%[Mm]}" ;;
    *) echo "$1" ;;
  esac
}
disk_bytes() {
  case "$1" in
    *[Gg]) echo "$(( ${1%[Gg]} * 1024 * 1024 * 1024 ))" ;;
    *[Mm]) echo "$(( ${1%[Mm]} * 1024 * 1024 ))" ;;
    *) echo "$1" ;;
  esac
}

# Update extensions in the host installation, never through the VM launcher
# at ~/.pi/agent/bin/pi. The refreshed host npm manifests are copied into VMs
# at launch, where their Linux-native optional dependencies are rebuilt.
host_node_root="$(mise where node@latest 2>/dev/null || true)"
host_pi="$host_node_root/bin/pi"
if [[ ! -x "$host_pi" ]]; then
  echo "Could not find the host Pi CLI under mise's node@latest installation." >&2
  exit 1
fi
echo "Updating host Pi extensions..."
"$host_pi" update --extensions

if ! orb info "$template" >/dev/null 2>&1; then
  echo "Creating persistent isolated Arch ARM64 template $template..."
  orb create \
    --arch arm64 \
    --isolated \
    --user pi \
    --cpus "$cpus" \
    --memory "$memory" \
    --disk "$disk" \
    arch:current "$template"
else
  echo "Updating persistent template $template in place..."
  orb stop "$template" >/dev/null 2>&1 || true
  orb config set "machine.$template.isolated" true
  orb config set "machine.$template.isolate_network" false
  orb config set "machine.$template.forward_ssh_agent" false
  orb config set "machine.$template.cpu" "$cpus"
  orb config set "machine.$template.memory_mib" "$(memory_mib "$memory")"
  orb config set "machine.$template.disk_bytes" "$(disk_bytes "$disk")"
  orb config set "machine.$template.mounts" ""
  orb start "$template" >/dev/null
fi

cleanup() {
  orb stop "$template" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# Copy the host-global Pi secrets file into the persistent template when
# present. It is intentionally not projected from the live host at runtime.
if [[ -f "$repo_root/.env" ]]; then
  cat "$repo_root/.env" | orb -m "$template" -u root tee /home/pi/.pi/.env >/dev/null
  orb -m "$template" -u root chown pi:pi /home/pi/.pi/.env
  orb -m "$template" -u root chmod 0600 /home/pi/.pi/.env
else
  orb -m "$template" -u root rm -f /home/pi/.pi/.env
fi

# PyInfra connects through OrbStack's built-in localhost-only SSH server. uv
# uses the repository lockfile and environment; guest-side caches remain in the
# persistent template.
PI_VM_TEMPLATE="$template" \
  mise exec -q uv@latest -- \
  uv run --project "$repo_root" pyinfra -y \
    --chdir "$repo_root/vm/pyinfra" \
    inventory.py deploy.py

# Validate the persistent base without requiring runtime host mounts. The
# preparation service intentionally skips itself until a disposable clone has
# /mnt/pi-launch mounted.
orb -m "$template" -u pi bash -lc '
  set -euo pipefail
  test "$(uname -m)" = aarch64
  ! command -v sudo >/dev/null
  command -v chromium >/dev/null
  command -v firefox >/dev/null
  command -v gh >/dev/null
  command -v php >/dev/null
  command -v composer >/dev/null
  php --version >/dev/null
  composer --version >/dev/null
  for extension in bcmath ctype curl dom exif fileinfo gd intl mbstring mysqli openssl PDO pdo_mysql pdo_pgsql pdo_sqlite redis soap sqlite3 tokenizer xml xsl zip; do
    php -m | grep -Fx "$extension" >/dev/null
  done
  export PATH="/home/pi/.local/share/mise/installs/uv/latest/bin:/home/pi/.local/share/mise/installs/node/latest/bin:/home/pi/.local/bin:/home/pi/.local/share/mise/shims:$PATH"
  export NODE_NO_WARNINGS=1
  /usr/local/bin/pi-prefetch-mcp
  /home/pi/.local/share/mise/installs/node/latest/bin/chrome-devtools-mcp --version >/dev/null
  /home/pi/.local/share/mise/installs/node/latest/bin/pi --version
  export DOCKER_HOST="unix:///run/user/$(id -u)/docker.sock"
  for _ in $(seq 1 120); do
    docker info >/dev/null 2>&1 && break
    sleep 0.1
  done
  docker info >/dev/null 2>&1
  docker run --rm alpine:latest true
'

cleanup
trap - EXIT
echo "Template $template is up to date and stopped."
