#!/bin/bash
set -euo pipefail

# Load the host-global Pi secrets file before constructing defaults or starting
# Node. This is the same ~/.pi/.env used by the VM template, but pi-unsafe
# runs directly on the host and therefore cannot rely on the guest entrypoint.
pi_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
if [[ -f "$pi_root/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$pi_root/.env"
  set +a
fi

export FACELIFT_THEME=gruvbox-dark-hard
export FACELIFT_MAX_PREVIEW_LINES=10
export LLAMA_BASE_URL="${LLAMA_BASE_URL:-http://127.0.0.1:8080}"
export PI_OFFLINE=1

# pi-update declares Pi as an npm-backed mise tool. Run from HOME so a
# project's tool configuration cannot select a different Pi installation.
# pi-web-search also registers Gemini-only url_context; expose only web_search.
exec mise exec -q -C "$HOME" -- pi "$@" --exclude-tools url_context
