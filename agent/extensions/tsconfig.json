{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"paths": {
			"@earendil-works/pi-coding-agent": [
				"../npm/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
			],
			"@earendil-works/pi-ai": ["../npm/node_modules/@earendil-works/pi-ai/dist/index.d.ts"],
			"@earendil-works/pi-tui": ["../npm/node_modules/@earendil-works/pi-tui/dist/index.d.ts"],
			"typebox": ["../npm/node_modules/typebox/build/cjs/index.d.ts"],
			"typebox/*": ["../npm/node_modules/typebox/*"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
