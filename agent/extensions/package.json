{
	"name": "pi-local-extensions",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint . --type-aware --type-check --tsconfig tsconfig.json --deny-warnings",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run read-agents shared --config chrome/vitest.config.ts",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
	},
	"dependencies": {
		"shiki": "^4.6.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.3",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
