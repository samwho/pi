{
	"name": "pi-local-extensions",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint . --type-aware --type-check --tsconfig tsconfig.json --deny-warnings",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run visuals read-agents --config visuals/vitest.config.ts",
		"bench:render": "vitest bench visuals/rendering.bench.ts --config visuals/vitest.config.ts",
		"test:scroll": "node visuals/perf/run.mjs",
		"profile:scroll": "node visuals/perf/run.mjs --profile",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
	},
	"dependencies": {
		"@shikijs/cli": "^4.4.3",
		"@vscode/vscode-languagedetection": "^1.0.23",
		"diff": "^8.0.4",
		"prettier": "^3.9.9",
		"shiki": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.20.3",
		"oxlint-tsgolint": "^7.0.2003",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
